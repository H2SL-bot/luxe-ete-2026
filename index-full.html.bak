":{"@type":"Offer","url":"https://www.oetkercollection.com/hotels/eden-rock-st-barths/","availability":"https://schema.org/InStock"}},{"@type":"Event","name":"Dîner de gala du Réveillon au Cheval Blanc St-Barth Isle de France","startDate":"2026-12-31","endDate":"2026-12-31","eventAttendanceMode":"https://schema.org/OfflineEventAttendanceMode","location":{"@type":"Place","name":"Baie des Flamands, Saint-Barthélemy","address":{"@type":"PostalAddress","addressLocality":"Cheval Blanc St-Barth (LVMH), restaurant La Case, plage des Flamands"}},"image":"https://constanceparis7.com/og-image.png","description":"Le reveillon le plus haute-couture de l'ile : diner de gala multi-services a La Case, la table gastronomique de la maison LVMH s","url":"https://www.chevalblanc.com/en/maison/st-barth/","eventStatus":"https://schema.org/EventScheduled","isAccessibleForFree":false,"offers":{"@type":"Offer","url":"https://www.chevalblanc.com/en/maison/st-barth/","availability":"https://schema.org/InStock"},"organizer":{"@type":"Organization","name":"L'accès est géré en interne par la Maison Cheval Blanc St-Barth","url":"https://www.chevalblanc.com/en/maison/st-barth/"}},{"@type":"Event","name":"Apollo in the Hamptons 2026 (gala-concert caritatif de l'Apollo Theater)","startDate":"2026-08-01","endDate":"2026-08-01","eventAttendanceMode":"https://schema.org/OfflineEventAttendanceMode","location":{"@type":"Place","name":"EHP Resort & Marina (restaurant Si Si), 295 Three Mile Harbor Hog Creek Road, East Hampton","address":{"@type":"PostalAddress","addressLocality":"East Hampton"}},"image":"https://constanceparis7.com/og-image.png","description":"Gala-concert le plus people des Hamptons, A-list historique (Bon Jovi, Sting), resort prive.","url":"https://www.apollotheater.org/apollo-in-the-hamptons-2026","eventStatus":"https://schema.org/EventScheduled","organizer":{"@type":"Organization","name":"The Apollo Theater","url":"https://www.apollotheater.org/apollo-in-the-hamptons-2026"},"isAccessi