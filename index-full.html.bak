<style>
  /* Thème natif : nuit Riviera (sombre), identité du site. Le clair reste disponible via le bouton thème. */
  :root{
    --bg:#0f151f; --bg2:#161d2a; --bg3:#1b2331;
    --ink:#eceadf; --ink2:#97a0b0; --line:#273143;
    --or:#d3b06a; --or-soft:rgba(211,176,106,.10); --or-line:rgba(211,176,106,.40);
    --azur:#74b9d6; --azur-soft:rgba(116,185,214,.10);
    --good:#4cc38a; --good-soft:rgba(76,195,138,.12);
    --shadow:0 1px 2px rgba(0,0,0,.3),0 10px 30px rgba(0,0,0,.35);
    --serif:"Didot","Bodoni 72","Bodoni MT",Georgia,serif;
    --sans:"Avenir Next",Avenir,"Helvetica Neue",Helvetica,Arial,sans-serif;
    color-scheme: dark;
  }
  :root[data-theme="light"]{
    --bg:#fafaf7; --bg2:#ffffff; --bg3:#f1efe8;
    --ink:#1a2230; --ink2:#5a6374; --line:#e3e1d8;
    --or:#a07c2e; --or-soft:rgba(160,124,46,.10); --or-line:rgba(160,124,46,.35);
    --azur:#16657f; --azur-soft:rgba(22,101,127,.09);
    --good:#1e7a52; --good-soft:rgba(30,122,82,.10);
    --shadow:0 1px 2px rgba(20,25,35,.05),0 8px 28px rgba(20,25,35,.06);
    color-scheme: light;
  }
  :root[data-theme="dark"]{
    --bg:#0f151f; --bg2:#161d2a; --bg3:#1b2331;
    --ink:#eceadf; --ink2:#97a0b0; --line:#273143;
    --or:#d3b06a; --or-soft:rgba(211,176,106,.10); --or-line:rgba(211,176,106,.40);
    --azur:#74b9d6; --azur-soft:rgba(116,185,214,.10);
    --good:#4cc38a; --good-soft:rgba(76,195,138,.12);
    --shadow:0 1px 2px rgba(0,0,0,.3),0 10px 30px rgba(0,0,0,.35);
  }
  *{box-sizing:border-box}
  html,body{margin:0;padding:0}
  body{background:var(--bg);color:var(--ink);font-family:var(--sans);font-size:15px;line-height:1.55;-webkit-font-smoothing:antialiased}
  a{color:var(--azur);text-decoration:none}
  a:hover{text-decoration:underline}
  a:focus-visible,button:focus-visible,input:focus-visible,summary:focus-visible{outline:2px solid var(--or);outline-offset:2px;border-radius:2px}
  .wrap{max-width:1180px;margin:0 auto;padding:0 28px}
  .eyebrow{font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:var(--or);font-weight:600}

  /* ─── Masthead ─── */
  header.mast{border-bottom:1px solid var(--line);padding:44px 0 30px}
  .mast-grid{display:flex;flex-wrap:wrap;gap:28px;align-items:flex-end;justify-content:space-between}
  h1{font-family:var(--serif);font-weight:400;font-size:clamp(34px,5vw,56px);line-height:1.04;margin:10px 0 6px;text-wrap:balance;letter-spacing:.01em}
  h1.wordmark{font-family:"Futura","Futura PT","Century Gothic","Avenir Next",var(--sans);font-weight:500;text-transform:uppercase;letter-spacing:.18em;font-size:clamp(26px,4vw,44px);margin:14px 0 8px}
  h1.wordmark .seven{color:var(--or)}
  h1 .fil{color:var(--or);font-style:italic}
  .brandline{font-family:var(--serif);font-style:italic;font-size:clamp(17px,2.2vw,24px);color:var(--or);margin:0 0 10px;letter-spacing:.03em}
  .brandline .fil{font-style:normal}
  .vtag{display:inline-block;vertical-align:super;font-family:var(--sans);font-size:13px;font-weight:700;letter-spacing:.1em;color:var(--or);border:1px solid var(--or-line);border-radius:5px;padding:2px 9px;background:var(--or-soft)}
  .mast-sub{color:var(--ink2);max-width:62ch}
  .clockcard{background:var(--bg2);border:1px solid var(--line);border-radius:6px;box-shadow:var(--shadow);padding:16px 22px;text-align:right;min-width:230px}
  .clock{font-size:42px;font-weight:200;letter-spacing:.06em;font-variant-numeric:tabular-nums;line-height:1.1}
  .clock small{font-size:20px;color:var(--ink2);font-weight:300}
  .clock-sub{font-size:12px;color:var(--ink2);margin-top:8px;display:flex;gap:7px;align-items:center;justify-content:flex-end}
  .worldclock{display:flex;gap:28px;justify-content:flex-end;flex-wrap:wrap}
  .wc{text-align:right}
  .wc-city{font-size:11px;letter-spacing:.2em;text-transform:uppercase;color:var(--or);font-weight:500;margin-bottom:3px}
  .wc-time{font-size:34px;font-weight:200;letter-spacing:.05em;font-variant-numeric:tabular-nums;line-height:1.05}
  .wc-time small{font-size:17px;color:var(--ink2);font-weight:300}
  .livedot{width:7px;height:7px;border-radius:50%;background:var(--good);display:inline-block;animation:pulse 2s infinite}
  @keyframes pulse{0%,100%{opacity:1}50%{opacity:.3}}
  @media (prefers-reduced-motion: reduce){.livedot{animation:none}}
  .theme-btn{background:none;border:1px solid var(--line);color:var(--ink2);border-radius:99px;padding:3px 12px;font-size:11px;cursor:pointer;font-family:var(--sans)}
  .lang-sel{background:var(--bg2);border:1px solid var(--or-line);color:var(--ink);border-radius:99px;padding:3px 10px;font-size:11px;cursor:pointer;font-family:var(--sans)}
  .lang-sel:hover{border-color:var(--or)}
  .stats{display:flex;flex-wrap:wrap;gap:26px;margin-top:26px}
  .stat b{display:block;font-family:var(--serif);font-size:30px;font-weight:400;font-variant-numeric:tabular-nums;line-height:1.1}
  .stat span{font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:var(--ink2)}
  .stat.gold b{color:var(--or)}

  /* ─── Filtres ─── */
  .filterbar{position:sticky;top:0;z-index:50;background:color-mix(in srgb,var(--bg) 88%,transparent);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);border-bottom:1px solid var(--line);padding:12px 0}
  .filrow{display:flex;flex-wrap:wrap;gap:8px;align-items:center}
  .filrow + .filrow{margin-top:8px}
  .navrow{padding-bottom:9px;margin-bottom:3px;border-bottom:1px solid var(--line)}
  .navchip{display:inline-block;border:1px solid var(--line);background:var(--bg2);color:var(--ink);border-radius:99px;padding:5px 14px;font-size:12.5px;font-weight:600;text-decoration:none;font-family:var(--sans);transition:border-color .15s,background .15s}
  .navchip:hover{border-color:var(--or);text-decoration:none}
  .navchip-star{background:var(--or);border-color:var(--or);color:#1a1206;font-weight:700}
  .navchip-star:hover{background:var(--or);filter:brightness(1.08)}
  .fillabel{font-size:10px;letter-spacing:.14em;text-transform:uppercase;color:var(--ink2);min-width:64px}
  section[id]{scroll-margin-top:200px}
  .chip{border:1px solid var(--line);background:var(--bg2);color:var(--ink);border-radius:99px;padding:4px 13px;font-size:12.5px;cursor:pointer;font-family:var(--sans);transition:border-color .15s}
  .chip:hover{border-color:var(--or)}
  .chip.on{background:var(--ink);color:var(--bg);border-color:var(--ink)}
  .chip .ct{color:inherit;opacity:.55;font-variant-numeric:tabular-nums}
  .chip.st-special.on{background:var(--or);border-color:var(--or);color:#fff}
  .search{margin-left:auto;border:1px solid var(--line);background:var(--bg2);color:var(--ink);border-radius:99px;padding:5px 15px;font-size:13px;font-family:var(--sans);width:210px}
  .search::placeholder{color:var(--ink2)}

  /* ─── Sections ─── */
  section{padding:38px 0 8px}
  h2{font-family:var(--serif);font-weight:400;font-size:27px;margin:4px 0 4px;letter-spacing:.01em}
  .sec-intro{color:var(--ink2);max-width:75ch;margin:2px 0 18px}

  /* Compte à rebours */
  #countdown-sec{padding-top:30px}
  .cd-band{background:linear-gradient(135deg,var(--bg2),var(--bg3));border:1px solid var(--or-line);border-radius:10px;box-shadow:var(--shadow);padding:22px 26px;display:flex;flex-wrap:wrap;align-items:center;gap:20px 34px}
  .cd-lead{flex:1 1 260px;min-width:240px}
  .cd-lead .lbl{font-size:11px;letter-spacing:.15em;text-transform:uppercase;color:var(--or);font-weight:700}
  .cd-lead .nm{font-family:var(--serif);font-size:clamp(20px,2.4vw,27px);line-height:1.2;margin:5px 0 3px;text-wrap:balance}
  .cd-lead .mt{font-size:12.5px;color:var(--ink2)}
  .cd-clock{display:flex;gap:12px}
  .cd-unit{text-align:center;min-width:58px}
  .cd-unit b{display:block;font-family:var(--serif);font-size:38px;line-height:1;color:var(--ink);font-variant-numeric:tabular-nums}
  .cd-unit span{font-size:9.5px;letter-spacing:.13em;text-transform:uppercase;color:var(--ink2)}
  .cd-unit.sep b{color:var(--or)}
  .cd-next{flex:1 1 100%;display:flex;flex-wrap:wrap;gap:8px;margin-top:4px;padding-top:14px;border-top:1px solid var(--line)}
  .cd-chip{font-size:12px;border:1px solid var(--line);border-radius:99px;padding:4px 12px;color:var(--ink2);cursor:pointer;background:var(--bg2)}
  .cd-chip:hover{border-color:var(--or);color:var(--ink)}
  .cd-chip b{color:var(--or);font-variant-numeric:tabular-nums;font-weight:700}

  /* Aujourd'hui */
  #today-strip{display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:12px;margin-top:14px}
  .todaycard{background:var(--bg2);border:1px solid var(--or-line);border-radius:8px;box-shadow:var(--shadow);padding:15px 17px;display:flex;flex-direction:column;gap:5px}
  .todaycard .th{display:flex;align-items:baseline;gap:9px}
  .todaycard .thr{font-family:var(--serif);font-size:20px;color:var(--or);font-variant-numeric:tabular-nums;white-space:nowrap}
  .todaycard .tt{font-family:var(--serif);font-size:16.5px;line-height:1.25}
  .todaycard .tm{font-size:12px;color:var(--ink2)}
  .todaycard .tl{display:flex;gap:14px;flex-wrap:wrap;margin-top:3px;font-size:12px}

  /* Séjour d'exception */
  details.sejour{margin-top:8px;border:1px solid var(--or-line);border-radius:6px;background:linear-gradient(160deg,var(--or-soft),transparent)}
  details.sejour summary{cursor:pointer;padding:9px 14px;font-size:12px;letter-spacing:.09em;text-transform:uppercase;color:var(--or);font-weight:700;list-style:none}
  details.sejour summary::before{content:"🥂 "}
  details.sejour summary::after{content:" +";float:right}
  details.sejour[open] summary::after{content:" −"}
  .sej-in{padding:2px 16px 14px}
  .sej-anchor{border-left:3px solid var(--or);padding:2px 0 2px 12px;margin:8px 0 10px}
  .sej-anchor .sej-star{display:block;font-size:9.5px;letter-spacing:.14em;text-transform:uppercase;color:var(--or);font-weight:700}
  .sej-anchor .sej-ev{display:block;font-family:var(--serif);font-size:17px;line-height:1.2;color:var(--ink);margin:2px 0}
  .sej-anchor .sej-meta{display:block;font-size:12px;color:var(--ink2)}
  .sej-lead{font-size:12.5px;color:var(--ink2);margin:4px 0 8px}
  .sej-pitch{font-family:var(--serif);font-size:15px;font-style:italic;color:var(--ink);margin:6px 0 10px;text-wrap:pretty}
  .sej-grp{margin:10px 0}
  .sej-grp > .lb{font-size:10px;letter-spacing:.13em;text-transform:uppercase;color:var(--ink2);display:block;margin-bottom:4px}
  .sej-item{padding:4px 0;border-top:1px solid var(--line)}
  .sej-item:first-of-type{border-top:none}
  .sej-item .nm{font-weight:600;color:var(--ink)}
  .sej-item .nm a{color:var(--or)}
  .sej-item .ds{font-size:12.5px;color:var(--ink2)}

  /* badge code vestimentaire + photo */
  .b.dress{background:var(--azur-soft);color:var(--azur)}
  .evfig{margin:8px 0;border-radius:6px;overflow:hidden;border:1px solid var(--line);max-width:520px}
  .evfig img{display:block;width:100%;height:auto;max-height:280px;object-fit:cover}
  .evfig figcaption{font-size:11px;color:var(--ink2);padding:5px 9px;background:var(--bg2)}

  /* En ce moment */
  #now-strip{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:12px;margin-top:14px}
  .nowcard{background:var(--bg2);border:1px solid var(--or-line);border-radius:6px;padding:14px 16px;box-shadow:var(--shadow)}
  .nowcard .t{font-family:var(--serif);font-size:17px;line-height:1.25;margin:5px 0 3px}
  .nowcard .m{font-size:12.5px;color:var(--ink2)}
  .now-tag{display:inline-flex;align-items:center;gap:6px;font-size:10px;letter-spacing:.13em;text-transform:uppercase;color:var(--or);font-weight:600}

  /* Classement Prestige */
  .prow{display:grid;grid-template-columns:64px 1fr;gap:16px;padding:18px 0;border-bottom:1px solid var(--line)}
  .prow:last-child{border-bottom:none}
  .prow.past{opacity:.55}
  .prank{font-family:var(--serif);font-size:30px;color:var(--or);line-height:1;font-variant-numeric:tabular-nums}
  .prank small{display:block;font-family:var(--sans);font-size:9px;letter-spacing:.12em;text-transform:uppercase;color:var(--ink2);margin-top:3px}
  .pscore{display:inline-flex;align-items:center;gap:7px;background:var(--or-soft);border:1px solid var(--or-line);border-radius:99px;padding:2px 11px;font-size:12px;color:var(--or);font-weight:700;font-variant-numeric:tabular-nums}
  .pdiam{letter-spacing:2px;font-size:11px}
  .pwhy{font-size:13px;color:var(--ink2);font-style:italic;margin:5px 0 0;max-width:80ch}
  .pmore{display:block;margin:20px auto 0;background:none;border:1px solid var(--or-line);color:var(--or);border-radius:99px;padding:8px 26px;font-family:var(--sans);font-size:13px;cursor:pointer;letter-spacing:.06em}
  .pmore:hover{background:var(--or-soft)}
  .maplink{white-space:nowrap}

  /* Calendrier */
  .cals{display:grid;grid-template-columns:repeat(auto-fit,minmax(330px,1fr));gap:14px;margin-top:14px}
  .cal-title{font-family:var(--serif);font-size:19px;margin-bottom:10px}
  .cal{background:var(--bg2);border:1px solid var(--line);border-radius:8px;box-shadow:var(--shadow);padding:18px}
  .cal-head{display:grid;grid-template-columns:repeat(7,1fr);gap:6px;margin-bottom:6px}
  .cal-head div{text-align:center;font-size:10px;letter-spacing:.12em;color:var(--ink2);text-transform:uppercase}
  .cal-grid{display:grid;grid-template-columns:repeat(7,1fr);gap:6px}
  .day{position:relative;border:1px solid var(--line);border-radius:5px;background:var(--bg);min-height:58px;padding:6px 8px;cursor:pointer;font-family:var(--sans);text-align:left;color:var(--ink)}
  .day:hover{border-color:var(--or)}
  .day.empty{border:none;background:none;cursor:default}
  .day .num{font-family:var(--serif);font-size:16px}
  .day .n-ev{position:absolute;bottom:5px;left:8px;right:8px;font-size:10.5px;color:var(--ink2);font-variant-numeric:tabular-nums}
  .day .bar{position:absolute;top:0;left:0;right:0;height:3px;border-radius:5px 5px 0 0;background:var(--or);opacity:.85}
  .day.past{opacity:.5}
  .day.today{border-color:var(--or);box-shadow:0 0 0 1px var(--or)}
  .day.today .num{color:var(--or);font-weight:700}
  .day.sel{background:var(--ink);color:var(--bg)}
  .day.sel .n-ev{color:inherit;opacity:.7}
  .cal-note{font-size:12px;color:var(--ink2);margin-top:12px}

  /* Agenda */
  .daygroup{margin:26px 0 0}
  .dg-head{display:flex;align-items:baseline;gap:12px;border-bottom:1px solid var(--line);padding-bottom:7px;margin-bottom:2px}
  .dg-head h3{font-family:var(--serif);font-weight:400;font-size:21px;margin:0}
  .dg-head .today-tag{font-size:10px;letter-spacing:.13em;text-transform:uppercase;color:var(--or);font-weight:700}
  .dg-head .past-tag{font-size:10px;letter-spacing:.13em;text-transform:uppercase;color:var(--ink2)}
  .evrow{display:grid;grid-template-columns:86px 1fr;gap:16px;padding:16px 0;border-bottom:1px solid var(--line)}
  .evrow:last-child{border-bottom:none}
  .evrow.past{opacity:.55}
  .hour{font-family:var(--serif);font-size:19px;color:var(--or);font-variant-numeric:tabular-nums;padding-top:2px}
  .hour small{display:block;font-family:var(--sans);font-size:10px;letter-spacing:.1em;text-transform:uppercase;color:var(--ink2)}
  .ev .t{font-family:var(--serif);font-size:18.5px;line-height:1.3;margin:0 0 4px;text-wrap:balance}
  .ev .meta{font-size:12.5px;color:var(--ink2);margin-bottom:6px}
  .ev .meta b{color:var(--ink);font-weight:600}
  .ev .ds{max-width:80ch;margin:4px 0}
  .badges{display:flex;flex-wrap:wrap;gap:6px;margin:7px 0 2px;align-items:center}
  .b{font-size:10.5px;letter-spacing:.08em;text-transform:uppercase;border-radius:3px;padding:2px 8px;font-weight:600}
  .b.public{background:var(--good-soft);color:var(--good)}
  .b.inscription{background:var(--azur-soft);color:var(--azur)}
  .b.invitation{background:var(--or-soft);color:var(--or)}
  .b.mixte,.b.inconnu{background:var(--bg3);color:var(--ink2)}
  .b.zone{background:none;border:1px solid var(--line);color:var(--ink2);font-weight:500}
  .b.live{background:var(--or);color:#fff}
  .conf{font-size:11px;color:var(--ink2)}
  .conf .d{display:inline-block;width:8px;height:8px;border-radius:50%;vertical-align:baseline;margin-right:4px}
  .conf.c2 .d{background:var(--good)}
  .conf.c1 .d{background:var(--or)}
  .conf.c0 .d{background:none;border:1.5px solid var(--ink2)}
  details.part{margin-top:8px;border:1px solid var(--line);border-radius:5px;background:var(--bg2)}
  details.part summary{cursor:pointer;padding:8px 13px;font-size:12px;letter-spacing:.09em;text-transform:uppercase;color:var(--or);font-weight:600;list-style:none}
  details.part summary::before{content:"+ "}
  details.part[open] summary::before{content:"− "}
  details.part .inner{padding:2px 14px 12px;font-size:13.5px}
  details.part .inner p{margin:7px 0}
  details.part .inner .lb{font-size:10px;letter-spacing:.12em;text-transform:uppercase;color:var(--ink2);display:block;margin-bottom:1px}
  .ctlist{margin:6px 0 2px;padding-left:18px;font-size:13px}
  .ctlist li{margin:3px 0}
  .ctlist b{color:var(--or);font-weight:600}
  .links{margin-top:8px;font-size:12.5px;display:flex;gap:16px;flex-wrap:wrap}
  .now-rule{display:flex;align-items:center;gap:12px;color:var(--or);font-size:11px;letter-spacing:.14em;text-transform:uppercase;font-weight:700;margin:2px 0}
  .now-rule::before,.now-rule::after{content:"";flex:1;height:1px;background:var(--or)}

  /* En continu */
  #continu-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(330px,1fr));gap:12px;margin-top:16px}
  .ccard{background:var(--bg2);border:1px solid var(--line);border-radius:6px;padding:15px 17px;box-shadow:var(--shadow);display:flex;flex-direction:column;gap:4px}
  .ccard .t{font-family:var(--serif);font-size:16.5px;line-height:1.3}
  .ccard .m{font-size:12px;color:var(--ink2)}

  /* International */
  #intl .cols{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:14px;margin-top:18px}
  .citycol{background:var(--bg2);border:1px solid var(--line);border-radius:6px;padding:16px;box-shadow:var(--shadow)}
  .citycol h3{font-family:var(--serif);font-weight:400;font-size:19px;margin:0 0 2px}
  .citycol .cnt{font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:var(--azur);margin-bottom:10px}
  .citycol ul{list-style:none;margin:0;padding:0}
  .citycol li{padding:8px 0;border-top:1px solid var(--line);font-size:13px}
  .citycol li .d{color:var(--or);font-variant-numeric:tabular-nums;font-size:11.5px;display:block}
  .circuit{background:var(--azur-soft);border:1px solid var(--line);border-radius:6px;padding:18px 22px;margin-top:16px;max-width:100%}
  .circuit p{margin:6px 0;max-width:90ch}

  /* Entrées */
  #entrees .egrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(320px,1fr));gap:12px;margin-top:16px}
  .ecard{background:var(--bg2);border:1px solid var(--or-line);border-radius:6px;padding:16px 18px}
  .ecard h3{font-family:var(--serif);font-weight:400;font-size:17px;margin:0 0 6px}
  .ecard p{font-size:13px;color:var(--ink2);margin:0 0 8px}
  .ecard .num{font-family:var(--serif);color:var(--or);font-size:14px}

  footer{border-top:1px solid var(--line);margin-top:50px;padding:26px 0 60px;color:var(--ink2);font-size:12.5px}
  footer p{max-width:90ch;margin:6px 0}
  .empty-msg{color:var(--ink2);padding:30px 0;font-style:italic}
  .table-scroll{overflow-x:auto}

  @media (max-width:720px){
    .wrap{padding:0 16px}
    .clockcard{text-align:left}
    .clock{font-size:32px}
    .clockcard{min-width:0}
    .worldclock{gap:20px;justify-content:flex-start}
    .wc{text-align:left}
    .wc-time{font-size:26px}
    .wc-time small{font-size:13px}
    .evrow{grid-template-columns:1fr;gap:4px}
    .hour{font-size:15px;display:flex;gap:8px;align-items:baseline}
    .search{width:100%;margin-left:0}
    .day{min-height:46px;padding:4px 6px}
    .day .n-ev{display:none}
  }


/* HERO-CONSTANCE-START */
  header.mast{position:relative;overflow:hidden;min-height:600px;isolation:isolate}
  header.mast::before{content:"";position:absolute;inset:0;z-index:0;background:url("hero-constance.jpg") 50% 40%/cover no-repeat}
  header.mast::after{content:"";position:absolute;inset:0;z-index:1;background:linear-gradient(103deg,rgba(15,21,31,.96),rgba(15,21,31,.90) 40%,rgba(15,21,31,.55) 62%,rgba(15,21,31,.12)),linear-gradient(to bottom,rgba(15,21,31,.72),rgba(15,21,31,0) 24%,rgba(15,21,31,0) 52%,rgba(15,21,31,.92))}
  header.mast>.wrap{position:relative;z-index:2}
  header.mast .mast-grid{flex-direction:column;align-items:flex-start;gap:20px}
  header.mast .clockcard{margin-top:2px}
  header.mast .wordmark{color:#f3f1e8}
  header.mast .mast-sub{color:#cfd5df}
  header.mast .stat b{color:#eceadf}
  header.mast .stat.gold b{color:var(--or)}
  header.mast .stat span{color:#c2c8d2}
  header.mast .clockcard{background:rgba(17,23,34,.62);border-color:rgba(211,176,106,.30);-webkit-backdrop-filter:blur(6px);backdrop-filter:blur(6px)}
  header.mast .wc-time{color:#f3f1e8}
  header.mast .wc-time small{color:#aab3c0}
  header.mast .clock-sub{color:#c2c8d2}
  .ig-credit{position:absolute;right:24px;bottom:16px;z-index:3;display:inline-flex;align-items:center;gap:7px;font-size:12px;letter-spacing:.03em;color:var(--or);text-decoration:none;padding:6px 12px 6px 10px;border:1px solid rgba(211,176,106,.38);border-radius:999px;background:rgba(15,21,31,.5);-webkit-backdrop-filter:blur(4px);backdrop-filter:blur(4px)}
  .ig-credit:hover{background:rgba(211,176,106,.16)}
  .ig-credit svg{width:15px;height:15px;fill:currentColor;display:block}
  @media(max-width:720px){header.mast{min-height:470px}header.mast::before{background-position:66% 40%}header.mast::after{background:linear-gradient(to bottom,rgba(15,21,31,.82),rgba(15,21,31,.35) 26%,rgba(15,21,31,.5) 56%,rgba(15,21,31,.95))}.ig-credit{right:14px;bottom:12px}}
  /* HERO-CONSTANCE-END */
  /* FILTER-COLLAPSE-START */
  .filter-toggle{display:none}
  .filterbar.collapsed .ft-ico::after{content:"+"}
  .filterbar:not(.collapsed) .ft-ico::after{content:"\2212"}
  @media(max-width:720px){
    .filterbar>.wrap{padding-top:9px;padding-bottom:9px}
    .filter-toggle{display:flex;align-items:center;justify-content:space-between;gap:10px;width:100%;font-family:inherit;background:var(--bg2);border:1px solid var(--line);color:var(--ink);border-radius:99px;padding:10px 18px;font-size:13px;font-weight:600;letter-spacing:.02em;cursor:pointer}
    .filter-toggle .ft-ico{font-size:19px;line-height:1;color:var(--or);font-weight:400}
    .filterbar.collapsed>.wrap>.filrow{display:none}
  }
  /* FILTER-COLLAPSE-END */
  
  
  
  /* SEC-COLLAPSE-START */
  @media(max-width:720px){
    .sec-collapse>.wrap>h2{cursor:pointer;position:relative;padding-right:36px;-webkit-tap-highlight-color:transparent}
    .sec-collapse>.wrap>h2::after{content:"\2212";position:absolute;right:2px;top:2px;color:var(--or);font-weight:400;font-size:26px;line-height:1}
    .sec-collapse.collapsed>.wrap>h2::after{content:"+"}
    .sec-collapse.collapsed>.wrap>h2~*{display:none!important}
    .sec-collapse.collapsed>.wrap>h2{margin-bottom:2px}
  }
  /* SEC-COLLAPSE-END */
  
  
  
  /* FILTER-OK-START */
  .filter-ok{display:none}
  @media(max-width:720px){
    .filter-ok{display:block;width:100%;margin-top:12px;font-family:inherit;background:var(--or);color:#1a1205;border:none;border-radius:99px;padding:13px 18px;font-size:15px;font-weight:700;letter-spacing:.02em;cursor:pointer;box-shadow:0 4px 16px rgba(211,176,106,.25)}
    .filter-ok:active{filter:brightness(.94)}
    .filterbar.collapsed .filter-ok{display:none}
  }
  /* FILTER-OK-END */
  /* 3CLOCKS-START */
  .worldclock{gap:22px}
  .wc-time{font-size:30px}
  @media(max-width:720px){
    .worldclock{gap:13px;flex-wrap:nowrap}
    .wc-time{font-size:21px}
    .wc-time small{font-size:11px}
    .wc-city{font-size:9.5px;letter-spacing:.1em}
  }
  /* 3CLOCKS-END */
  /* PRESTIGE-HERO-START */
  #prestige>.wrap>.eyebrow{letter-spacing:.22em;color:var(--or)}
  #prestige>.wrap>h2{font-size:clamp(30px,4.6vw,40px);letter-spacing:.005em;margin-top:2px}
  #prestige>.wrap>h2::before{content:"\2605";color:var(--or);font-size:.6em;margin-right:.42em;vertical-align:.1em}
  @media(max-width:720px){#prestige>.wrap>h2{font-size:29px}}
  /* PRESTIGE-HERO-END */
  /* 4CLOCKS-START */
  .worldclock{gap:18px}
  .wc-time{font-size:26px}
  .wc-time small{font-size:14px}
  @media(max-width:720px){
    .worldclock{gap:10px}
    .wc-time{font-size:17px}
    .wc-time small{font-size:10px}
    .wc-city{font-size:8.5px;letter-spacing:.08em}
  }
  /* 4CLOCKS-END */
</style>
</head>
